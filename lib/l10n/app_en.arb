  "alcoholMilestone1Title": "Sleep Quality Begins to Improve",
  "@alcoholMilestone1Title": {
    "description": "Alcohol milestone day 1 title"
  },
  "alcoholMilestone1Description": "Your REM sleep cycles start to normalize within the first day. While alcohol might help you fall asleep initially, it disrupts deep sleep and REM cycles throughout the night, causing fragmented sleep.",
  "@alcoholMilestone1Description": {
    "description": "Alcohol milestone day 1 description"
  },
  "alcoholMilestone3Title": "Hydration Levels Restore",
  "@alcoholMilestone3Title": {
    "description": "Alcohol milestone day 3 title"
  },
  "alcoholMilestone3Description": "Your kidneys are recovering from alcohol's diuretic effects. Alcohol suppresses antidiuretic hormone, leading to increased urination and dehydration. By day 3, your body's fluid balance is improving significantly.",
  "@alcoholMilestone3Description": {
    "description": "Alcohol milestone day 3 description"
  },
  "alcoholMilestone7Title": "Immune System Strengthens",
  "@alcoholMilestone7Title": {
    "description": "Alcohol milestone day 7 title"
  },
  "alcoholMilestone7Description": "Your white blood cells are recovering their function. Even a single bout of heavy drinking can impair immune function for up to 24 hours, and chronic drinking significantly weakens your body's ability to fight infections.",
  "@alcoholMilestone7Description": {
    "description": "Alcohol milestone day 7 description"
  },
  "alcoholMilestone14Title": "Brain Volume Recovery Begins",
  "@alcoholMilestone14Title": {
    "description": "Alcohol milestone day 14 title"
  },
  "alcoholMilestone14Description": "Brain volume begins recovering within the first two weeks. Thinking and memory keep improving over the following months.",
  "@alcoholMilestone14Description": {
    "description": "Alcohol milestone day 14 description"
  },
  "alcoholMilestone30Title": "Blood Pressure Normalizes",
  "@alcoholMilestone30Title": {
    "description": "Alcohol milestone day 30 title"
  },
  "alcoholMilestone30Description": "Your cardiovascular system shows significant improvement. Regular alcohol consumption elevates blood pressure, but abstinence for about a month can help bring blood pressure back to healthier levels.",
  "@alcoholMilestone30Description": {
    "description": "Alcohol milestone day 30 description"
  },
  "alcoholMilestone60Title": "Liver Function Improves",
  "@alcoholMilestone60Title": {
    "description": "Alcohol milestone day 60 title"
  },
  "alcoholMilestone60Description": "Your liver shows measurable improvement in function. This regenerative organ can recover significantly from alcohol-induced damage, with liver enzymes and fat accumulation showing improvement within 2 months of abstinence.",
  "@alcoholMilestone60Description": {
    "description": "Alcohol milestone day 60 description"
  },
  "alcoholMilestone90Title": "Thinking and Memory Improve Substantially",
  "@alcoholMilestone90Title": {
    "description": "Alcohol milestone day 90 title"
  },
  "alcoholMilestone90Description": "The first three months bring major gains in memory, concentration, and decision-making, with recovery continuing across the following months.",
  "@alcoholMilestone90Description": {
    "description": "Alcohol milestone day 90 description"
  },
  "alcoholMilestone180Title": "Brain Volume and Function Continue Recovery",
  "@alcoholMilestone180Title": {
    "description": "Alcohol milestone day 180 title"
  },
  "alcoholMilestone180Description": "Six months sober gives the brain sustained time to recover. Brain volume and thinking skills continue to improve.",
  "@alcoholMilestone180Description": {
    "description": "Alcohol milestone day 180 description"
  },
  "alcoholMilestone365Title": "Cancer Risk Reduction May Begin",
  "@alcoholMilestone365Title": {
    "description": "Alcohol milestone day 365 title"
  },
  "alcoholMilestone365Description": "One year of abstinence may begin to reduce cancer risk. While alcohol clearly increases risk for several cancers (liver, breast, colorectal, esophageal), research on risk reduction timeline is still emerging and varies by cancer type.",
  "@alcoholMilestone365Description": {
    "description": "Alcohol milestone day 365 description"
  },
  "smokingMilestone1Title": "Carbon Monoxide Clears",
  "@smokingMilestone1Title": {
    "description": "Smoking milestone day 1 title"
  },
  "smokingMilestone1Description": "Your blood is breathing again! Within 24 hours, carbon monoxide levels drop to normal and oxygen levels increase. Your heart doesn't have to work overtime anymore to pump poisoned blood around your body.",
  "@smokingMilestone1Description": {
    "description": "Smoking milestone day 1 description"
  },
  "smokingMilestone3Title": "Nicotine Withdrawal Peaks",
  "@smokingMilestone3Title": {
    "description": "Smoking milestone day 3 title"
  },
  "smokingMilestone3Description": "The nicotine monster is at its angriest, but you're winning the battle! All nicotine has left your system. The worst cravings happen now, but they're also your ticket to freedom on the other side.",
  "@smokingMilestone3Description": {
    "description": "Smoking milestone day 3 description"
  },
  "smokingMilestone7Title": "Taste & Smell Dramatically Improve",
  "@smokingMilestone7Title": {
    "description": "Smoking milestone day 7 title"
  },
  "smokingMilestone7Description": "Food is about to become an adventure again! Smoking destroys taste buds and smell receptors. One week in, and you're rediscovering flavors you forgot existed. Prepare for some serious food appreciation!",
  "@smokingMilestone7Description": {
    "description": "Smoking milestone day 7 description"
  },
  "smokingMilestone14Title": "Circulation & Walking Improve",
  "@smokingMilestone14Title": {
    "description": "Smoking milestone day 14 title"
  },
  "smokingMilestone14Description": "Your legs are thanking you with every step! Blood circulation improves dramatically, making walking and exercise noticeably easier. Those stairs aren't looking so intimidating anymore, are they?",
  "@smokingMilestone14Description": {
    "description": "Smoking milestone day 14 description"
  },
  "smokingMilestone30Title": "Lung Function Increases",
  "@smokingMilestone30Title": {
    "description": "Smoking milestone day 30 title"
  },
  "smokingMilestone30Description": "Your lungs are throwing a comeback party! Cilia have regrown and are sweeping out years of tar and debris. Lung capacity increases significantly, and that smoker's cough is history.",
  "@smokingMilestone30Description": {
    "description": "Smoking milestone day 30 description"
  },
  "smokingMilestone90Title": "Heart Attack Risk Drops Significantly",
  "@smokingMilestone90Title": {
    "description": "Smoking milestone day 90 title"
  },
  "smokingMilestone90Description": "Your heart is sending love letters! Three months smoke-free and your cardiovascular risk has already dropped substantially. Your cardiovascular system is healing faster than you might think possible.",
  "@smokingMilestone90Description": {
    "description": "Smoking milestone day 90 description"
  },
  "smokingMilestone180Title": "Immune System Strengthens",
  "@smokingMilestone180Title": {
    "description": "Smoking milestone day 180 title"
  },
  "smokingMilestone180Description": "Your immune system just got a superhero upgrade! Six months without smoking and your white blood cells are back to full strength, fighting infections like the champions they were born to be.",
  "@smokingMilestone180Description": {
    "description": "Smoking milestone day 180 description"
  },
  "smokingMilestone365Title": "Stroke Risk Reduces Significantly",
  "@smokingMilestone365Title": {
    "description": "Smoking milestone day 365 title"
  },
  "smokingMilestone365Description": "One full year of freedom! Your stroke risk has decreased substantially, and your blood vessels are healing beautifully. You've officially given your brain the gift of better circulation and protection.",
  "@smokingMilestone365Description": {
    "description": "Smoking milestone day 365 description"
  },
  "smokingMilestone1825Title": "Cancer Risk Plummets (5 Years)",
  "@smokingMilestone1825Title": {
    "description": "Smoking milestone day 1825 title"
  },
  "smokingMilestone1825Description": "Five years of victory! Your risk of mouth, throat, esophagus, and bladder cancers has dropped by half. Lung cancer risk has decreased significantly too. Your cells have had time to repair and regenerate.",
  "@smokingMilestone1825Description": {
    "description": "Smoking milestone day 1825 description"
  },
  "vapingMilestone1Title": "Nicotine Cravings Peak",
  "@vapingMilestone1Title": {
    "description": "Vaping milestone day 1 title"
  },
  "vapingMilestone1Description": "Your brain is throwing a nicotine tantrum, but you're already winning! Within 24 hours, nicotine levels drop dramatically. The worst cravings happen now, but they're also the most important to push through.",
  "@vapingMilestone1Description": {
    "description": "Vaping milestone day 1 description"
  },
  "vapingMilestone3Title": "Breathing Improves",
  "@vapingMilestone3Title": {
    "description": "Vaping milestone day 3 title"
  },
  "vapingMilestone3Description": "Your lungs are doing a happy dance! Bronchial tubes begin to relax and lung capacity starts improving. That tight chest feeling from vaping is already beginning to ease up.",
  "@vapingMilestone3Description": {
    "description": "Vaping milestone day 3 description"
  },
  "vapingMilestone7Title": "Taste & Smell Return",
  "@vapingMilestone7Title": {
    "description": "Vaping milestone day 7 title"
  },
  "vapingMilestone7Description": "Food is about to taste amazing again! Nicotine dampens taste buds and smell receptors. A week in, and your sensory superpowers are making their comeback tour.",
  "@vapingMilestone7Description": {
    "description": "Vaping milestone day 7 description"
  },
  "vapingMilestone14Title": "Circulation Improves",
  "@vapingMilestone14Title": {
    "description": "Vaping milestone day 14 title"
  },
  "vapingMilestone14Description": "Your blood is flowing like a champion! Nicotine constricts blood vessels, but two weeks smoke-free and your circulation is dramatically improving. Cold hands and feet, begone!",
  "@vapingMilestone14Description": {
    "description": "Vaping milestone day 14 description"
  },
  "vapingMilestone30Title": "Lung Function Recovery",
  "@vapingMilestone30Title": {
    "description": "Vaping milestone day 30 title"
  },
  "vapingMilestone30Description": "Your lungs are practically throwing a celebration parade! Cilia (tiny lung cleaners) have regenerated and lung function has improved significantly. That morning cough is history!",
  "@vapingMilestone30Description": {
    "description": "Vaping milestone day 30 description"
  },
  "vapingMilestone60Title": "Anxiety Levels Normalize",
  "@vapingMilestone60Title": {
    "description": "Vaping milestone day 60 title"
  },
  "vapingMilestone60Description": "Plot twist: vaping was making anxiety worse, not better! Two months in, your usual anxiety level is lower and your nervous system is settling.",
  "@vapingMilestone60Description": {
    "description": "Vaping milestone day 60 description"
  },
  "vapingMilestone90Title": "Focus and Memory Sharpen",
  "@vapingMilestone90Title": {
    "description": "Vaping milestone day 90 title"
  },
  "vapingMilestone90Description": "Brain fog has left the building! Three months without nicotine and your focus, memory, and clear thinking are markedly better. It's like upgrading your mental RAM.",
  "@vapingMilestone90Description": {
    "description": "Vaping milestone day 90 description"
  },
  "vapingMilestone180Title": "Oral Health Recovery",
  "@vapingMilestone180Title": {
    "description": "Vaping milestone day 180 title"
  },
  "vapingMilestone180Description": "Your mouth is sending thank-you cards! Six months vape-free and gum inflammation decreases, tooth staining fades, and your risk of oral health issues drops substantially.",
  "@vapingMilestone180Description": {
    "description": "Vaping milestone day 180 description"
  },
  "vapingMilestone365Title": "Cardiovascular Risk Reduction",
  "@vapingMilestone365Title": {
    "description": "Vaping milestone day 365 title"
  },
  "vapingMilestone365Description": "Your heart is literally stronger! One full year and your risk of heart disease has dropped significantly. Your cardiovascular system has recovered from nicotine's daily assault course.",
  "@vapingMilestone365Description": {
    "description": "Vaping milestone day 365 description"
  },
  "socialMediaMilestone1Title": "Digital Detox Day One! 🎯",
  "@socialMediaMilestone1Title": {
    "description": "Social media milestone day 1 title"
  },
  "socialMediaMilestone1Description": "You've officially started rewiring your brain! Research shows that even thinking about checking social media triggers the same neural pathways as addiction. But you're already breaking the cycle - go you!",
  "@socialMediaMilestone1Description": {
    "description": "Social media milestone day 1 description"
  },
  "socialMediaMilestone3Title": "FOMO? More Like FO-NO! 😎",
  "@socialMediaMilestone3Title": {
    "description": "Social media milestone day 3 title"
  },
  "socialMediaMilestone3Description": "Three days in and those anxious 'what am I missing?' thoughts are already fading. You're training your brain that real life is way more interesting than curated feeds!",
  "@socialMediaMilestone3Description": {
    "description": "Social media milestone day 3 description"
  },
  "socialMediaMilestone7Title": "Attention Span: Goldfish → Human 🧠",
  "@socialMediaMilestone7Title": {
    "description": "Social media milestone day 7 title"
  },
  "socialMediaMilestone7Description": "Week one complete! Your ability to focus without checking your phone every few minutes is already improving. Studies show our brains crave the dopamine hits from notifications - but you're teaching yours to find rewards elsewhere!",
  "@socialMediaMilestone7Description": {
    "description": "Social media milestone day 7 description"
  },
  "socialMediaMilestone14Title": "Sleep Like a Baby (Not a Zombie) 😴",
  "@socialMediaMilestone14Title": {
    "description": "Social media milestone day 14 title"
  },
  "socialMediaMilestone14Description": "Two weeks without scrolling before bed = better sleep quality! The blue light from screens suppresses melatonin production, but your natural sleep rhythms are bouncing back beautifully.",
  "@socialMediaMilestone14Description": {
    "description": "Social media milestone day 14 description"
  },
  "socialMediaMilestone30Title": "Real Friends > Fake Likes 💝",
  "@socialMediaMilestone30Title": {
    "description": "Social media milestone day 30 title"
  },
  "socialMediaMilestone30Description": "One month offline = significant reductions in loneliness and depression! Research proves that limiting social media creates major mental health improvements. You've gone even further!",
  "@socialMediaMilestone30Description": {
    "description": "Social media milestone day 30 description"
  },
  "socialMediaMilestone60Title": "Comparison Trap: ESCAPED! ✨",
  "@socialMediaMilestone60Title": {
    "description": "Social media milestone day 60 title"
  },
  "socialMediaMilestone60Description": "Two months without constant social comparison = confidence through the roof! Research consistently shows that social media use correlates with decreased self-esteem, especially from upward social comparisons. You've broken free from the comparison trap!",
  "@socialMediaMilestone60Description": {
    "description": "Social media milestone day 60 description"
  },
  "socialMediaMilestone90Title": "Hobby Collector Level: Expert 🎨",
  "@socialMediaMilestone90Title": {
    "description": "Social media milestone day 90 title"
  },
  "socialMediaMilestone90Description": "Three months = roughly 270+ hours reclaimed! That's enough time to learn a skill, read 15+ books, or get deep into a hobby. Your brain strengthens the habits you repeat, so those offline routines are becoming easier and more automatic.",
  "@socialMediaMilestone90Description": {
    "description": "Social media milestone day 90 description"
  },
  "socialMediaMilestone180Title": "Mental Health Glow-Up Complete 🌟",
  "@socialMediaMilestone180Title": {
    "description": "Social media milestone day 180 title"
  },
  "socialMediaMilestone180Description": "Six months offline and you're officially thriving! Long-term studies show that reducing social media use leads to sustained improvements in wellbeing, self-esteem, and life satisfaction. You're living proof that life's better in the real world!",
  "@socialMediaMilestone180Description": {
    "description": "Social media milestone day 180 description"
  },
  "socialMediaMilestone365Title": "Digital Zen Master Achieved 🏆",
  "@socialMediaMilestone365Title": {
    "description": "Social media milestone day 365 title"
  },
  "socialMediaMilestone365Description": "One full year of intentional living! You've reclaimed 1,000+ hours, formed deeper relationships, and proved that the best moments in life aren't meant for sharing - they're meant for experiencing. You're officially a digital wellness legend!",
  "@socialMediaMilestone365Description": {
    "description": "Social media milestone day 365 description"
  },
  "nicotinePouchesMilestone1Title": "Taste & Smell Begin Recovery",
  "@nicotinePouchesMilestone1Title": {
    "description": "Nicotine pouches milestone day 1 title"
  },
  "nicotinePouchesMilestone1Description": "Nicotine dulls your taste buds and smell receptors. After just 24 hours without pouches, these senses start their comeback tour! Food is about to taste amazing again.",
  "@nicotinePouchesMilestone1Description": {
    "description": "Nicotine pouches milestone day 1 description"
  },
  "nicotinePouchesMilestone3Title": "Nicotine Completely Cleared",
  "@nicotinePouchesMilestone3Title": {
    "description": "Nicotine pouches milestone day 3 title"
  },
  "nicotinePouchesMilestone3Description": "Your body has officially evicted all nicotine! While withdrawal symptoms might peak around now, remember - this is your brain rewiring itself for freedom. The hardest part is almost over.",
  "@nicotinePouchesMilestone3Description": {
    "description": "Nicotine pouches milestone day 3 description"
  },
  "nicotinePouchesMilestone7Title": "Oral Health Improves",
  "@nicotinePouchesMilestone7Title": {
    "description": "Nicotine pouches milestone day 7 title"
  },
  "nicotinePouchesMilestone7Description": "Your gums are throwing a celebration! Nicotine pouches can cause gum irritation and recession. After a week, blood flow to your gums normalizes and healing begins.",
  "@nicotinePouchesMilestone7Description": {
    "description": "Nicotine pouches milestone day 7 description"
  },
  "nicotinePouchesMilestone14Title": "Circulation Enhancement",
  "@nicotinePouchesMilestone14Title": {
    "description": "Nicotine pouches milestone day 14 title"
  },
  "nicotinePouchesMilestone14Description": "Your blood vessels are doing a happy dance! Nicotine constricts blood vessels, but two weeks free and your circulation is significantly improved. Hello, warmer hands and feet!",
  "@nicotinePouchesMilestone14Description": {
    "description": "Nicotine pouches milestone day 14 description"
  },
  "nicotinePouchesMilestone30Title": "Stress Response Normalizes",
  "@nicotinePouchesMilestone30Title": {
    "description": "Nicotine pouches milestone day 30 title"
  },
  "nicotinePouchesMilestone30Description": "Plot twist: nicotine actually increases stress between uses! Your cortisol and stress response are returning to normal. Real relaxation, not the nicotine fake-out.",
  "@nicotinePouchesMilestone30Description": {
    "description": "Nicotine pouches milestone day 30 description"
  },
  "nicotinePouchesMilestone60Title": "Sleep Quality Improves",
  "@nicotinePouchesMilestone60Title": {
    "description": "Nicotine pouches milestone day 60 title"
  },
  "nicotinePouchesMilestone60Description": "Sweet dreams are made of... no nicotine! While nicotine seems relaxing, it actually disrupts sleep architecture. Two months in, and your REM cycles are beautifully restored.",
  "@nicotinePouchesMilestone60Description": {
    "description": "Nicotine pouches milestone day 60 description"
  },
  "nicotinePouchesMilestone90Title": "Dopamine Receptors Recover",
  "@nicotinePouchesMilestone90Title": {
    "description": "Nicotine pouches milestone day 90 title"
  },
  "nicotinePouchesMilestone90Description": "Your brain's reward system is back online! Nicotine hijacks dopamine pathways, making normal pleasures seem dull. Three months free, and life's natural joys are vibrant again.",
  "@nicotinePouchesMilestone90Description": {
    "description": "Nicotine pouches milestone day 90 description"
  },
  "nicotinePouchesMilestone180Title": "Cardiovascular Risk Drops",
  "@nicotinePouchesMilestone180Title": {
    "description": "Nicotine pouches milestone day 180 title"
  },
  "nicotinePouchesMilestone180Description": "Your heart is sending love letters! Six months without nicotine significantly reduces cardiovascular disease risk. Your blood pressure and heart rate variability are vastly improved.",
  "@nicotinePouchesMilestone180Description": {
    "description": "Nicotine pouches milestone day 180 description"
  },
  "nicotinePouchesMilestone365Title": "Long-term Health Secured",
  "@nicotinePouchesMilestone365Title": {
    "description": "Nicotine pouches milestone day 365 title"
  },
  "nicotinePouchesMilestone365Description": "One year of freedom! Your risk of nicotine-related health issues continues to plummet. You've broken the addiction cycle and reclaimed your autonomy. That's genuinely heroic! 🏆",
  "@nicotinePouchesMilestone365Description": {
    "description": "Nicotine pouches milestone day 365 description"
  },
  "pornographyMilestone1Title": "Taking Back Control",
  "@pornographyMilestone1Title": {
    "description": "Pornography milestone day 1 title"
  },
  "pornographyMilestone1Description": "Problematic pornography use is defined by impaired control and resulting distress or impairment. One day matters because you have already interrupted the old pattern once and started identifying what triggers it.",
  "@pornographyMilestone1Description": {
    "description": "Pornography milestone day 1 description"
  },
  "pornographyMilestone3Title": "Know Your Urges",
  "@pornographyMilestone3Title": {
    "description": "Pornography milestone day 3 title"
  },
  "pornographyMilestone3Description": "People with more severe problematic use commonly report intrusive sexual thoughts, difficult-to-control desire, irritability, mood shifts, and sleep problems. Day three is a useful point to name which of those are actually happening for you.",
  "@pornographyMilestone3Description": {
    "description": "Pornography milestone day 3 description"
  },
  "pornographyMilestone7Title": "One Week: Trial Evidence",
  "@pornographyMilestone7Title": {
    "description": "Pornography milestone day 7 title"
  },
  "pornographyMilestone7Description": "In a randomized 7-day abstinence study, regular users showed no overall withdrawal syndrome. An exploratory subgroup with both high problematic use and daily viewing had more craving, so a rough first week is possible but not inevitable.",
  "@pornographyMilestone7Description": {
    "description": "Pornography milestone day 7 description"
  },
  "pornographyMilestone14Title": "Map Your Triggers",
  "@pornographyMilestone14Title": {
    "description": "Pornography milestone day 14 title"
  },
  "pornographyMilestone14Description": "Two weeks gives you repeated exposure to the situations that used to cue pornography. Research links problematic use with factors including craving, stress, avoidance, loneliness, and coping style; knowing your own pattern gives you something concrete to change.",
  "@pornographyMilestone14Description": {
    "description": "Pornography milestone day 14 description"
  },
  "pornographyMilestone30Title": "A Month of Control",
  "@pornographyMilestone30Title": {
    "description": "Pornography milestone day 30 title"
  },
  "pornographyMilestone30Description": "A month is a meaningful test of control. In a 14,581-person study, sexual-function problems were associated more strongly with problematic use than with simple viewing frequency, so regaining control is the more evidence-based target.",
  "@pornographyMilestone30Description": {
    "description": "Pornography milestone day 30 description"
  },
  "pornographyMilestone90Title": "Change Can Hold",
  "@pornographyMilestone90Title": {
    "description": "Pornography milestone day 90 title"
  },
  "pornographyMilestone90Description": "A randomized ACT trial for problematic pornography use found large reductions in viewing after 12 sessions, with substantial reductions still present at 3-month follow-up. Durable change is realistic, especially when you build structured skills instead of relying only on willpower.",
  "@pornographyMilestone90Description": {
    "description": "Pornography milestone day 90 description"
  },
  "pornographyMilestone180Title": "Six-Month Stability",
  "@pornographyMilestone180Title": {
    "description": "Pornography milestone day 180 title"
  },
  "pornographyMilestone180Description": "A randomized CBT study for out-of-control sexual behaviour found improvements in symptoms, sexual compulsivity, and well-being that remained stable at 3- and 6-month follow-up. Long-term control can be maintained.",
  "@pornographyMilestone180Description": {
    "description": "Pornography milestone day 180 description"
  },
  "pornographyMilestone365Title": "One Year: Durable Change",
  "@pornographyMilestone365Title": {
    "description": "Pornography milestone day 365 title"
  },
  "pornographyMilestone365Description": "One-year follow-up data from an acceptance-based treatment study found participants did not return to pretreatment hypersexuality levels. A year of maintained change is credible evidence of a durable pattern, not a magical brain-reset date.",
  "@pornographyMilestone365Description": {
    "description": "Pornography milestone day 365 description"
  },
  "pornographyMilestone1825Title": "Five Years of Control",
  "@pornographyMilestone1825Title": {
    "description": "Pornography milestone day 1825 title"
  },
  "pornographyMilestone1825Description": "Five years is long-term maintenance. CSBD is clinically defined by persistent loss of control with distress or impairment, so maintaining control and functioning well over years is a meaningful outcome in its own right.",
  "@pornographyMilestone1825Description": {
    "description": "Pornography milestone day 1825 description"
  },
  "customMilestone1Title": "Initial Recovery Phase Begins",
  "@customMilestone1Title": {
    "description": "Custom milestone day 1 title"
  },
  "customMilestone1Description": "Your body starts the healing process! Within 24 hours of quitting, your system begins to clear toxins and adjust to functioning without addictive substances. Sleep disturbances are common but part of the recovery process.",
